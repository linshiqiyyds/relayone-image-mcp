{
  "name": "relayone-image-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An MCP wrapper template for an OpenAI-compatible image generation site.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
